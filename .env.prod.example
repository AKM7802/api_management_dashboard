# Copy to .env.prod and fill in real values. Never commit .env.prod.
#
#   cp .env.prod.example .env.prod

# --- Postgres (transactional store) -----------------------------------
POSTGRES_USER=apimgmt
POSTGRES_PASSWORD=change-me-generate-with-openssl-rand-hex-24
POSTGRES_DB=apimgmt

# --- Backend secrets -----------------------------------------------------
# openssl rand -hex 32
JWT_SECRET=change-me
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-me

# --- Public URLs -----------------------------------------------------------
# The frontend's own public URL — becomes the backend's CORS allowlist.
FRONTEND_URL=https://app.example.com
# The backend's own public URL — baked into the frontend's JS bundle at
# BUILD time (see docker-compose.prod.yml). Changing this later requires
# rebuilding the frontend image, not just restarting the container.
BACKEND_URL=https://api.example.com
